<?xml version="1.0" encoding="utf-8"?><!--
   API 30 以下向けの Auto Backup ルール（API 31+ は data_extraction_rules.xml が優先）。
   お気に入り・食べた記録・メモ・写真はユーザーが明示的に選ばない限り外部クラウドへ送らない方針のため、
   すべて除外する（allowBackup="false" と二重に安全側へ倒している）。
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
